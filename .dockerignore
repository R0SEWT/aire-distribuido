# Lo que no necesita la compilación. Mantiene chico el contexto que se manda
# al daemon: data/ puede tener el CSV de OEFA de 1.3 GB.
data/
.beads/
notebooks/
experimentos/
# La UI tiene su propia imagen, con web/ como contexto (web/Dockerfile).
web/

# De docs/ y reports/ solo entra lo que la API lee al arrancar: el contrato, el
# modelo que siembra, la ficha de estaciones y los centroides iniciales.
docs/*
!docs/api/
reports/*
!reports/kmeans.json
!reports/regimenes.json
!reports/estandarizacion.json
!reports/estaciones_ficha.csv
!reports/centroides_iniciales.json

# Git y configuración de herramientas.
.git
.github/
.claude/
.codex/
.agents/

# Artefactos locales.
bin/
*.test
*.out
coverage.*
.env
