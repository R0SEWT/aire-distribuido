%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#ffffff", "primaryBorderColor": "#555555", "lineColor": "#444444", "clusterBkg": "#fafafa", "clusterBorder": "#9a9a9a", "edgeLabelBackground": "#ffffff"}, "flowchart": {"nodeSpacing": 22, "rankSpacing": 40, "wrappingWidth": 400, "diagramPadding": 24}}}%%
%% Arquitectura del sistema: las cuatro partes del enunciado, MongoDB y Redis,
%% y qué va en cada contenedor de Docker Compose. Fuente de arquitectura.png
%% (se renderiza con docs/diagramas/renderizar.sh).
flowchart TB
    oefa[("<b>CSV de OEFA</b><br/>1.3 GB · formato largo<br/>34 estaciones")]

    subgraph compose["Docker Compose"]
        direction TB

        subgraph cargar["cargar · Parte A · PC3"]
            direction LR
            lector["<b>lector</b><br/>bloques de 64 MB"] -->|"canal"| workersA["<b>W workers</b><br/>reglas 1–6<br/>pivot por bloque"]
            workersA -->|"parciales"| recolector["<b>recolector</b><br/>fusión en<br/>orden de bloque"]
            recolector --> estandar["<b>z-score</b><br/>Welford + Chan"]
        end

        datos[("<b>volumen data/</b><br/>silver · gold<br/>orden: estación, hora")]

        subgraph nodos["nodos · Parte B · PC4"]
            direction LR
            n1["<b>nodo 1</b><br/>filas [0, n₁)<br/>worker pool"]
            n2["<b>nodo 2</b><br/>filas [n₁, n₂)<br/>worker pool"]
            nk["<b>nodo K</b><br/>filas [nₖ₋₁, N)<br/>worker pool"]
            n1 ~~~ n2 ~~~ nk
        end

        subgraph api["api · Parte C · PC4"]
            coord["<b>coordinador</b><br/>barrera por iteración<br/>plazo por ronda<br/>fusión en orden de nodo"]
            rest["<b>REST + JWT</b><br/>clasifica una<br/>lectura en &lt; 100 ms"]
            ws["<b>WebSocket</b><br/>progreso · alertas<br/>métricas"]
        end

        mongo[("<b>MongoDB</b><br/>persistente: corridas,<br/>centroides, regímenes")]
        redis[("<b>Redis</b><br/>caché: predicciones,<br/>centroides por ronda")]

        subgraph web["web · Parte D · TB2"]
            spa["<b>SPA</b><br/>login · dashboard · mapa<br/>resultados · alertas<br/>admin: nodos, CPU, latencia"]
        end
    end

    extra["<b>Medición extra · PC4</b><br/>nodos reales, Tailscale:<br/>gorgo · caja 4060<br/>Pixel 9a · Colab"]

    oefa -->|"bronze"| cargar
    cargar --> datos
    datos -->|"cada nodo carga<br/>su rango una vez"| nodos
    nodos <==>|"<b>TCP · JSON por línea</b><br/>↑ HOLA · LISTO · PARCIAL<br/>↓ CARGAR · ITERAR · FIN"| coord
    extra -.....->|"HOLA: el nodo<br/>se conecta al<br/>coordinador"| coord
    coord -->|"modelo y<br/>métricas"| mongo
    coord -->|"centroides<br/>por ronda"| redis
    rest <-->|"caché"| redis
    rest -->|"lee el modelo"| mongo
    rest <-->|"REST + JWT"| spa
    ws -->|"JSON por WebSocket"| spa

    classDef pc3 fill:#e3f1e5,stroke:#2e7d32,color:#1b3d1f
    classDef pc4 fill:#e6eef9,stroke:#1f5fa8,color:#13355e
    classDef tb2 fill:#f7ece0,stroke:#b5651d,color:#5b3210
    classDef dato fill:#f1f1f1,stroke:#666666,color:#222222
    classDef ext fill:#ffffff,stroke:#888888,stroke-dasharray: 4 3,color:#333333
    class lector,workersA,recolector,estandar pc3
    class n1,n2,nk,coord,rest,ws pc4
    class spa tb2
    class oefa,datos,mongo,redis dato
    class extra ext
    style compose fill:#ffffff,stroke:#555555,stroke-width:2px
