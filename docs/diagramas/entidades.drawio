    <mxCell id="c5" value="&lt;b&gt;predicciones&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;índice estacion_ts {estacion, ts}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f1e5;strokeColor=#2e7d32;fontColor=#1b3d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="290" height="34" as="geometry"/></mxCell>
    <mxCell id="c6" value="&lt;b&gt;_id&lt;/b&gt; · ObjectId (lo genera el driver)&lt;br&gt;&lt;b&gt;ts&lt;/b&gt; · fecha: cuándo se predijo&lt;br&gt;&lt;b&gt;estacion&lt;/b&gt; · texto → estaciones._id&lt;br&gt;&lt;b&gt;fecha_hora&lt;/b&gt; · fecha: hora de la lectura&lt;br&gt;&lt;b&gt;pm2_5&lt;/b&gt; · número, µg/m³&lt;br&gt;&lt;b&gt;pm10&lt;/b&gt; · número, µg/m³&lt;br&gt;&lt;b&gt;regimen&lt;/b&gt; · entero&lt;br&gt;&lt;b&gt;excede_eca&lt;/b&gt; · booleano, del régimen&lt;br&gt;&lt;b&gt;media_24h&lt;/b&gt; · {pm2_5, pm10, lecturas}&lt;br&gt;&lt;b&gt;alerta&lt;/b&gt; · booleano, de la media de 24 h&lt;br&gt;&lt;b&gt;inca&lt;/b&gt; · texto o null: banda INCA&lt;br&gt;&lt;b&gt;modelo_id&lt;/b&gt; · texto → modelos._id&lt;br&gt;&lt;b&gt;ms&lt;/b&gt; · número: latencia en el servidor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#222222;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="134" width="290" height="233" as="geometry"/></mxCell>
    <mxCell id="c7" value="&lt;b&gt;modelos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;índices activo {activo} y creado {creado}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f1e5;strokeColor=#2e7d32;fontColor=#1b3d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="300" height="34" as="geometry"/></mxCell>
    <mxCell id="c8" value="&lt;b&gt;_id&lt;/b&gt; · texto: sembrado-… o entrenado-{id}&lt;br&gt;&lt;b&gt;creado&lt;/b&gt; · fecha&lt;br&gt;&lt;b&gt;origen&lt;/b&gt; · «sembrado» o → entrenamientos._id&lt;br&gt;&lt;b&gt;receta&lt;/b&gt; · {features, k, semilla, tolerancia…}&lt;br&gt;&lt;b&gt;gold_sha256&lt;/b&gt; · texto: huella del gold&lt;br&gt;&lt;b&gt;estandarizacion&lt;/b&gt; · {features, n, media, desv…}&lt;br&gt;&lt;b&gt;centroides_std&lt;/b&gt; · k × D números&lt;br&gt;&lt;b&gt;centroides&lt;/b&gt; · k × D, unidades originales&lt;br&gt;&lt;b&gt;regimenes&lt;/b&gt; · [{regimen, excede_eca, medias, tamano}]&lt;br&gt;&lt;b&gt;inercia&lt;/b&gt; · número&lt;br&gt;&lt;b&gt;iteraciones&lt;/b&gt; · entero&lt;br&gt;&lt;b&gt;activo&lt;/b&gt; · booleano: a lo sumo uno true" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#222222;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="134" width="300" height="216" as="geometry"/></mxCell>
