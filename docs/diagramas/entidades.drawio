    <mxCell id="predicciones" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:16px&quot;&gt;predicciones&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;Una lectura clasificada&lt;/font&gt;&lt;hr&gt;&lt;b&gt;PK _id&lt;/b&gt;: ObjectId&lt;br&gt;&lt;b&gt;FK estacion&lt;/b&gt;: estaciones._id&lt;br&gt;&lt;b&gt;FK modelo_id&lt;/b&gt;: modelos._id&lt;br&gt;ts, fecha_hora: Date&lt;br&gt;pm2_5, pm10, regimen, excede_eca&lt;br&gt;media_24h {pm2_5, pm10, lecturas}&lt;br&gt;alerta, inca, ms&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#172B4D;fontSize=12;shadow=1;" vertex="1" parent="1">
