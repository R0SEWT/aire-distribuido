    <mxCell id="c26" value="&lt;b&gt;Línea continua:&lt;/b&gt; referencia por id. MongoDB no impone claves foráneas: la relación la mantiene la API.&lt;br&gt;&lt;b&gt;Línea punteada:&lt;/b&gt; correspondencia por nombre, o copia en la caché.&lt;br&gt;Las fechas de MongoDB son BSON Date; las de Redis, texto." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="240" height="160" as="geometry"/></mxCell>
