    <mxCell id="c10" value="&lt;b&gt;_id&lt;/b&gt; · texto: e-AAAAMMDD-HHMM&lt;br&gt;&lt;b&gt;inicio&lt;/b&gt; · fecha&lt;br&gt;&lt;b&gt;fin&lt;/b&gt; · fecha o null&lt;br&gt;&lt;b&gt;estado&lt;/b&gt; · en_curso | terminado | abortado&lt;br&gt;&lt;b&gt;parametros&lt;/b&gt; · {nodos, replicas, semilla}&lt;br&gt;&lt;b&gt;nodos&lt;/b&gt; · [{nombre, direccion, workers, rango {desde, hasta}}]&lt;br&gt;&lt;b&gt;rondas&lt;/b&gt; · [{iter, inercia, ms_ronda, ms_fusion, ms_por_nodo}]&lt;br&gt;&lt;b&gt;iteraciones&lt;/b&gt; · entero&lt;br&gt;&lt;b&gt;paro&lt;/b&gt; · tolerancia | max_iter | null&lt;br&gt;&lt;b&gt;dif_secuencial&lt;/b&gt; · número o null&lt;br&gt;&lt;b&gt;ms_total&lt;/b&gt; · número o null&lt;br&gt;&lt;b&gt;modelo_id&lt;/b&gt; · texto o null → modelos._id&lt;br&gt;&lt;b&gt;aviso&lt;/b&gt; · texto o null&lt;br&gt;&lt;b&gt;error&lt;/b&gt; · texto o null: nombra al nodo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#222222;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="484" width="410" height="250" as="geometry"/></mxCell>
