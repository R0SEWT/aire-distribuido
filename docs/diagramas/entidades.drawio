    <mxCell id="c6" value="&lt;b&gt;_id&lt;/b&gt; · ObjectId (lo genera el driver)&lt;br&gt;&lt;b&gt;ts&lt;/b&gt; · fecha: cuándo se predijo&lt;br&gt;&lt;b&gt;estacion&lt;/b&gt; · texto → estaciones._id&lt;br&gt;&lt;b&gt;fecha_hora&lt;/b&gt; · fecha: hora de la lectura&lt;br&gt;&lt;b&gt;pm2_5&lt;/b&gt; · número, µg/m³&lt;br&gt;&lt;b&gt;pm10&lt;/b&gt; · número, µg/m³&lt;br&gt;&lt;b&gt;regimen&lt;/b&gt; · entero&lt;br&gt;&lt;b&gt;excede_eca&lt;/b&gt; · booleano, del régimen&lt;br&gt;&lt;b&gt;media_24h&lt;/b&gt; · {pm2_5, pm10, lecturas}&lt;br&gt;&lt;b&gt;alerta&lt;/b&gt; · booleano, de la media de 24 h&lt;br&gt;&lt;b&gt;inca&lt;/b&gt; · texto o null: banda INCA&lt;br&gt;&lt;b&gt;modelo_id&lt;/b&gt; · texto → modelos._id&lt;br&gt;&lt;b&gt;ms&lt;/b&gt; · número: latencia en el servidor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="330" height="261" as="geometry"/></mxCell>
