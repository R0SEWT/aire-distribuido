    <mxCell id="c8" value="&lt;b&gt;_id&lt;/b&gt; · texto: sembrado-… o entrenado-{id}&lt;br&gt;&lt;b&gt;creado&lt;/b&gt; · fecha&lt;br&gt;&lt;b&gt;origen&lt;/b&gt; · «sembrado» o → entrenamientos._id&lt;br&gt;&lt;b&gt;receta&lt;/b&gt; · {features, k, semilla, tolerancia…}&lt;br&gt;&lt;b&gt;gold_sha256&lt;/b&gt; · texto: huella del gold&lt;br&gt;&lt;b&gt;estandarizacion&lt;/b&gt; · {features, n, media, desv…}&lt;br&gt;&lt;b&gt;centroides_std&lt;/b&gt; · k × D números&lt;br&gt;&lt;b&gt;centroides&lt;/b&gt; · k × D, unidades originales&lt;br&gt;&lt;b&gt;regimenes&lt;/b&gt; · [{regimen, excede_eca, medias, tamano}]&lt;br&gt;&lt;b&gt;inercia&lt;/b&gt; · número&lt;br&gt;&lt;b&gt;iteraciones&lt;/b&gt; · entero&lt;br&gt;&lt;b&gt;activo&lt;/b&gt; · booleano: a lo sumo uno true" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#2e7d32;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="120" width="350" height="242" as="geometry"/></mxCell>
