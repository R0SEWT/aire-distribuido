# Variables de Docker Compose. Copia este archivo a .env (que no se versiona) y
# completa los valores; «docker compose» lo lee solo.

# Clave con que la API firma los JWT (HS256), de al menos 32 bytes. Genera una:
#   openssl rand -hex 32
JWT_SECRETO=

# Usuarios de la API: usuario:clave:rol separados por comas, con rol usuario o
# admin. Cambia las claves: no dejes las del ejemplo.
API_USUARIOS=admin:cambia-esta-clave:admin,demo:cambia-esta-clave:usuario

# Opcional: ingreso de invitado. En la pantalla de ingreso, «No pienso crearme
# una cuenta aquí» deja entrar sin clave con la cuenta que se nombre aquí: un
# usuario de API_USUARIOS con el rol usuario (si no existe o es admin, la API no
# arranca y dice por qué). Sin la variable no hay ingreso de invitado.
# Cuidado: el invitado tiene el rol usuario y por tanto puede mandar lecturas
# (POST /api/predicciones), que cambian el estado de las estaciones. En una
# máquina pública, habilitarlo es una decisión, no un descuido.
# API_INVITADO=demo

# Opcional: cuánto dura un token (una hora si no se pone). No se renueva: al
# vencer, la UI vuelve al ingreso. Para una demo larga, por ejemplo 4h.
# JWT_DURACION=1h

# Opcionales: puertos en localhost y la carpeta del gold que leen los nodos.
# WEB_PORT=8081
# API_PORT=8080
# MONGO_PORT=27017
# REDIS_PORT=6379
# GOLD_DIR=./data/gold
